<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"
     xmlns:gx="http://www.google.com/kml/ext/2.2">
  <Document>
    <name>Ornek GES / Earth kamera yolu</name>
    <Snippet>Hacettepe B-5 bolgesi etrafinda basit dikdortgen orbit (lon, lat, m).</Snippet>
    <description>
      Bu dosya Digital Twin KML oynatici ile uyumludur (gx:coord: boylam enlem yukseklik_m).
      Kendi Google Earth Studio projenizden: Render &gt; Export &gt; KML (veya Track) secip
      benzer gx:Track / gx:coord ciktisi alabilirsiniz.
    </description>
    <Placemark>
      <name>Campus orbit ornegi</name>
